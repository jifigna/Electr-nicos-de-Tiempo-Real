    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;

    cs_high();

    init_err = lis_init();

    if (init_err != 0) {
        estado = Fallo;
    }

    // Verificación de registros
    lis_read(WHOAMI_REG, (uint8_t*)&who, 1);
    lis_read(CTRL_REG4, (uint8_t*)&r4, 1);
    lis_read(CTRL_REG5, (uint8_t*)&r5, 1);
    lis_read(CTRL_REG6, (uint8_t*)&r6, 1);

    /* USER CODE END 2 */

    osKernelInitialize();
